# Copiar a .env.local y completar.

# Neon (los completa `neon deploy` / `neon env pull`)
# Pooled (-pooler): lo usa la app
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Directa (sin -pooler): la usa `npm run db:setup` para crear las tablas
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (login con Google para alumnos, profes y admin)
# NEON_AUTH_BASE_URL lo escribe `neon deploy` cuando neon.ts tiene auth: true.
NEON_AUTH_BASE_URL=
# Secreto propio de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Cuentas de Google que pueden entrar a /admin, separadas por coma
ADMIN_EMAILS=

# Emails a profes (perfil publicado, rechazado, materia sumada) y aviso al admin de perfiles nuevos.
# Con Resend (resend.com, gratis hasta 3.000/mes). Sin estas tres variables no se manda nada.
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend
EMAIL_FROM="Tirita <hola@tudominio.com.ar>"
# Dirección pública del sitio, para los links de los emails
SITE_URL=https://tudominio.com.ar

# Las fotos de los profes se guardan en la propia base (tabla photos): no hace falta otro servicio.
